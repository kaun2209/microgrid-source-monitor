{
  "version": 1,
  "author": "Kaung Kyaw Moe",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-slide-switch", "id": "sw_grid", "top": -90, "left": -170, "attrs": {} },
    { "type": "wokwi-slide-switch", "id": "sw_gen", "top": -20, "left": -170, "attrs": {} },
    { "type": "wokwi-led", "id": "led_grid", "top": -110, "left": 230, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "led_gen", "top": -50, "left": 230, "attrs": { "color": "yellow" } },
    { "type": "wokwi-led", "id": "led_batt", "top": 10, "left": 230, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -60, "left": 150, "attrs": { "value": "220" } },
